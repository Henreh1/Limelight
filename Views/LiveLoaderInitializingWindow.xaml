<Window x:Class="Limelight.Views.LiveLoaderInitializingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Loader Initialising"
        Width="600"
        Height="455"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Focusable="True"
        WindowStartupLocation="Manual"
        FontFamily="Bahnschrift, Segoe UI"
        Foreground="{StaticResource TextBrush}">

    <Border Padding="1"
            Background="{StaticResource BorderBrush}"
            CornerRadius="16">

        <Border Padding="34"
                Background="{StaticResource BackgroundBrush}"
                CornerRadius="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="LIVE LOADER"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}"/>

                    <TextBlock Text="SETTING THE STAGE"
                               Margin="0,9,0,0"
                               FontSize="29"
                               FontWeight="Black"/>

                    <Rectangle Width="76"
                               Height="4"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Left"
                               Fill="{StaticResource PinkBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,26,0,0">

                    <Border Padding="22"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="PhaseText"
                                       Text="WAITING FOR DEAD AS DISCO"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyanBrush}"/>

                            <StackPanel Grid.Column="1"
                                        Margin="18,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="ETA"
                                           HorizontalAlignment="Right"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="EtaText"
                                           Text="CALCULATING"
                                           Margin="0,3,0,0"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PinkBrush}"/>
                            </StackPanel>

                            <TextBlock x:Name="DetailText"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="Limelight is waiting for the game and UE4SS runtime bridge to become ready."
                                       Margin="0,11,0,0"
                                       FontSize="13"
                                       LineHeight="20"
                                       TextWrapping="Wrap"
                                       Foreground="#C8C6D8"/>

                            <!-- The moving light confirms that the resolver is
                                 alive without pretending to know its percentage. -->
                            <Border Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Height="9"
                                    Margin="0,22,0,0"
                                    Background="#252943"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True">

                                <Grid x:Name="InitialisationProgressTrack"
                                      ClipToBounds="True">

                                    <Border x:Name="InitialisationProgressIndicator"
                                            Width="120"
                                            HorizontalAlignment="Left"
                                            CornerRadius="5">

                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="1,0">
                                                <GradientStop Offset="0"
                                                              Color="#0039DDF5"/>
                                                <GradientStop Offset="0.45"
                                                              Color="#FF39DDF5"/>
                                                <GradientStop Offset="1"
                                                              Color="#0039DDF5"/>
                                            </LinearGradientBrush>
                                        </Border.Background>

                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="InitialisationProgressTransform"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="Please leave Limelight open while the loader mounts and verifies the active mod. Live switching will unlock automatically."
                               Margin="2,18,2,0"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="&#x25C6;  INITIALISING SAFELY"
                           Margin="0,24,0,0"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource PinkBrush}"/>
            </Grid>
        </Border>
    </Border>
</Window>
