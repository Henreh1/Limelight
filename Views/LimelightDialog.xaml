<Window x:Class="Limelight.Views.LimelightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="660"
        MinHeight="320"
        MaxHeight="680"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Bahnschrift, Segoe UI">

    <Window.Resources>
        <Style x:Key="DialogTitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,12,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource PinkBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource AnimatedDialogCardStyle}"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="13">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Direction="270"
                              Opacity="0.42"
                              ShadowDepth="8"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Every prompt uses the same quiet title bar so it feels like
                 part of Limelight instead of a Windows alert. -->
            <Border x:Name="TitleBar"
                    Background="#0C0E1D"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="13,13,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="18,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TitleBarDiamond"
                                   Text="&#x25C6;"
                                   Margin="0,0,10,0"
                                   FontSize="9"
                                   Foreground="{StaticResource PinkBrush}"/>
                        <TextBlock x:Name="WindowTitleText"
                                   Text="LIMELIGHT"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Style="{StaticResource DialogTitleBarButtonStyle}"
                            ToolTip="Close">
                        <Path Width="11"
                              Height="11"
                              Data="M 0.8,0.8 L 10.2,10.2 M 10.2,0.8 L 0.8,10.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.4"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="32,30,32,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ToneIconBorder"
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#22162D"
                        BorderBrush="{StaticResource PinkBrush}"
                        BorderThickness="1"
                        CornerRadius="11">
                    <TextBlock x:Name="ToneIconText"
                               Text="!"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource PinkBrush}"/>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="EyebrowText"
                               Text="LIMELIGHT MESSAGE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}"/>
                    <TextBlock x:Name="HeadingText"
                               Text="THE SHOW NEEDS YOUR ATTENTION"
                               Margin="0,7,0,0"
                               FontSize="24"
                               FontWeight="Bold"
                               LineHeight="29"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}"/>
                    <Rectangle x:Name="AccentLine"
                               Width="72"
                               Height="4"
                               Margin="0,13,0,0"
                               HorizontalAlignment="Left"
                               Fill="{StaticResource PinkBrush}"/>
                    <TextBlock x:Name="MessageText"
                               Margin="0,17,0,0"
                               FontSize="14"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Foreground="#D3D1DF"/>

                    <Border x:Name="DetailPanel"
                            Margin="0,17,0,0"
                            Padding="15,12"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <ScrollViewer MaxHeight="190"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DetailText"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Padding="24,18"
                    Background="#0C0E1D"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,13,13">
                <Grid>
                    <TextBlock x:Name="FooterHintText"
                               Margin="4,0,20,0"
                               VerticalAlignment="Center"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="CancelActionButton"
                                MinWidth="104"
                                Content="CANCEL"
                                Visibility="Collapsed"
                                Style="{StaticResource SecondaryButton}"/>
                        <Button x:Name="SecondaryActionButton"
                                MinWidth="112"
                                Margin="10,0,0,0"
                                Content="NOT NOW"
                                Visibility="Collapsed"
                                Style="{StaticResource SecondaryButton}"/>
                        <Button x:Name="PrimaryActionButton"
                                MinWidth="112"
                                Margin="10,0,0,0"
                                Content="OK"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
