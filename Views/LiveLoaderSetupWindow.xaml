<Window x:Class="Limelight.Views.LiveLoaderSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Loader Setup"
        Width="620"
        Height="610"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        FontFamily="Bahnschrift, Segoe UI"
        Foreground="{StaticResource TextBrush}">

    <Border Padding="1"
            Background="{StaticResource BorderBrush}"
            CornerRadius="16">

        <Border Padding="36"
                Background="{StaticResource BackgroundBrush}"
                CornerRadius="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Heading -->
                <StackPanel>
                    <TextBlock Text="OPTIONAL LIVE LOADER"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}"/>

                    <TextBlock Text="ENABLE LIVE MODEL SWITCHING?"
                               Margin="0,10,0,0"
                               FontSize="28"
                               FontWeight="Black"/>

                    <Rectangle Width="76"
                               Height="4"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Left"
                               Fill="{StaticResource PinkBrush}"/>
                </StackPanel>

                <!-- Explanation -->
                <StackPanel Grid.Row="1"
                            Margin="0,24,0,0">

                    <TextBlock Text="Limelight did not find the optional runtime used by its live-loader features. Setup can download and install it for you."
                               FontSize="15"
                               LineHeight="23"
                               TextWrapping="Wrap"
                               Foreground="#C8C6D8"/>

                    <Border Margin="0,20,0,0"
                            Padding="20"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">

                        <StackPanel>
                            <TextBlock Text="WHAT SETUP WILL ADD"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyanBrush}"/>

                            <TextBlock Text="◆  Validated official UE4SS build for Dead as Disco"
                                       Margin="0,12,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="◆  Dead as Disco UE 5.7 signatures and quiet settings"
                                       Margin="0,12,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="◆  Limelight runtime bridge, created and enabled locally"
                                       Margin="0,12,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="◆  Runtime files installed in the game's Win64 folder"
                                       Margin="0,12,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="No character mods are downloaded during setup. The mod library still works if you choose Not Now."
                                       Margin="0,12,0,0"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       Foreground="#9498BD"/>
                        </StackPanel>
                    </Border>

                    <!-- Keep the source visible so users always know where
                         the third-party runtime is coming from. -->
                    <Button Margin="0,14,0,0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OpenSource_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SourceBorder"
                                        Padding="16,13"
                                        Background="#11182B"
                                        BorderBrush="{StaticResource CyanBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="OFFICIAL DOWNLOAD SOURCE"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource CyanBrush}"/>

                                            <TextBlock Text="github.com/UE4SS-RE/RE-UE4SS"
                                                       Margin="0,4,0,0"
                                                       FontSize="13"
                                                       Foreground="#D9DAE8"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Margin="18,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="OPEN  ↗"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CyanBrush}"/>
                                    </Grid>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="SourceBorder"
                                                Property="Background"
                                                Value="#17233A"/>
                                        <Setter TargetName="SourceBorder"
                                                Property="BorderBrush"
                                                Value="{StaticResource PinkBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Row="2"
                            Margin="0,28,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">

                    <Button Content="NOT NOW"
                            Click="NotNow_Click"
                            Style="{StaticResource SecondaryButton}"/>

                    <Button Content="SET UP LIVE LOADER"
                            Click="Setup_Click"
                            Margin="12,0,0,0"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
