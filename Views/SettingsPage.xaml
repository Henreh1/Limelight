<UserControl x:Class="Limelight.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Bahnschrift, Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar"
                   BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
        </ScrollViewer.Resources>

        <StackPanel Margin="38,30">
            <TextBlock Text="SETTINGS"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{StaticResource CyanBrush}"/>

            <TextBlock Text="KEEP THE SHOW RUNNING"
                       Margin="0,5,0,0"
                       FontSize="27"
                       FontWeight="Bold"/>

            <TextBlock Text="Check Limelight's live session, repair managed loader files, or prepare a private diagnostic report."
                       Margin="0,8,0,0"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"/>

            <Border Margin="0,28,0,0"
                    Padding="24"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="GAME CONNECTION"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="GameConnectionStatusText"
                                   Text="NOT CONNECTED"
                                   Margin="0,10,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>

                        <TextBlock x:Name="GameConnectionDetailText"
                                   Text="Choose the Dead as Disco installation folder."
                                   Margin="0,7,20,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                        <Button x:Name="ChangeGameFolderButton"
                                Content="CHANGE GAME FOLDER"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                Click="ChangeGameFolderButton_Click"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="13,8"
                            VerticalAlignment="Top"
                            Background="#1A1E35"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                        <TextBlock x:Name="GameRunningBadgeText"
                                   Text="NOT RUNNING"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- X19 listens globally, so this key remains available while the game has focus. -->
            <Border Margin="0,16,0,0"
                    Padding="24"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PinkBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="X19 LLOADER HOTKEY"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>

                        <TextBlock Text="IN-GAME ROTATION CONTROL"
                                   Margin="0,9,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="X19HotkeyStatusText"
                                   Text="Choose the key that advances to the next character in your X19 group. It is active only while Dead as Disco is selected."
                                   Margin="0,7,24,0"
                                   MaxWidth="650"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            MinWidth="104"
                            Height="58"
                            Margin="20,0"
                            Padding="18,0"
                            VerticalAlignment="Center"
                            Background="#0D1020"
                            BorderBrush="{StaticResource PinkBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <TextBlock x:Name="X19HotkeyText"
                                   Text="F8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>
                    </Border>

                    <Button x:Name="CaptureX19HotkeyButton"
                            Grid.Column="2"
                            Content="CHANGE HOTKEY"
                            MinWidth="138"
                            VerticalAlignment="Center"
                            Click="CaptureX19Hotkey_Click"
                            PreviewKeyDown="CaptureX19Hotkey_PreviewKeyDown"
                            Style="{StaticResource SecondaryButton}"/>
                </Grid>
            </Border>

            <!-- Rich Presence is opt-in because Discord activity is visible to other people. -->
            <Border Margin="0,16,0,0"
                    Padding="24"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DISCORD RICH PRESENCE"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="DiscordPresenceStatusText"
                                   Text="PRIVATE"
                                   Margin="0,10,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>

                        <TextBlock x:Name="DiscordPresenceDetailText"
                                   Text="Enable this to share Limelight, game, active-mod, and X19 activity on your Discord profile."
                                   Margin="0,7,24,0"
                                   MaxWidth="720"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <Button x:Name="DiscordPresenceButton"
                            Grid.Column="1"
                            Content="ENABLE PRESENCE"
                            MinWidth="156"
                            VerticalAlignment="Center"
                            Click="DiscordPresenceButton_Click"
                            Style="{StaticResource SecondaryButton}"/>
                </Grid>
            </Border>

            <!-- This card keeps the private testing boundary obvious before anybody connects a personal key. -->
            <Border Margin="0,16,0,0"
                    Padding="24"
                    Background="#17152A"
                    BorderBrush="{StaticResource PinkBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="NEXUS API TEST PROGRAM"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>

                        <TextBlock Text="PRIVATE TESTING BUILD"
                                   Margin="0,9,0,0"
                                   FontSize="19"
                                   FontWeight="Bold"/>

                        <TextBlock Margin="0,8,24,0"
                                   MaxWidth="820"
                                   Text="This build uses personal API keys only for private development and registration testing. Do not distribute it as a public Nexus-enabled release until Nexus Mods has reviewed and registered Limelight. No share my work!!!"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                        <UniformGrid Margin="0,19,0,0"
                                     Columns="2">
                            <Border Margin="0,0,7,7"
                                    Padding="14"
                                    Background="#111528"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="REQUEST IDENTITY"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="LIMELIGHT 0.1.0"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="7,0,0,7"
                                    Padding="14"
                                    Background="#111528"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="CREDENTIAL STORAGE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="THIS WINDOWS ACCOUNT ONLY"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,7,7,0"
                                    Padding="14"
                                    Background="#111528"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="CATALOGUE CACHE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="15 MINUTES"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="7,7,0,0"
                                    Padding="14"
                                    Background="#21172C"
                                    BorderBrush="#6B3158"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="REGISTRATION STATUS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="NOT SUBMITTED"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- I keep live request activity visible so testing never quietly consumes the connected account's quota. -->
                        <Border Margin="0,18,0,0"
                                Padding="16"
                                Background="#0E1223"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="LIVE API TESTING ACTIVITY"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="Quota values are read directly from Nexus response headers."
                                                   Margin="0,4,18,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Padding="10,6"
                                            VerticalAlignment="Center"
                                            Background="#21172C"
                                            BorderBrush="#6B3158"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <TextBlock x:Name="NexusTestingStatusText"
                                                   Text="WAITING FOR FIRST REQUEST"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PinkBrush}"/>
                                    </Border>
                                </Grid>

                                <UniformGrid Margin="0,14,0,0"
                                             Columns="3">
                                    <Border Margin="0,0,6,0"
                                            Padding="12"
                                            Background="#14192E"
                                            CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock Text="THIS SESSION"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock x:Name="NexusSessionRequestCountText"
                                                       Text="0"
                                                       Margin="0,5,0,0"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource CyanBrush}"/>
                                            <TextBlock Text="REQUESTS"
                                                       Margin="0,2,0,0"
                                                       FontSize="8"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="3,0"
                                            Padding="12"
                                            Background="#14192E"
                                            CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock Text="HOURLY REMAINING"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock x:Name="NexusHourlyRemainingText"
                                                       Text="UNKNOWN"
                                                       Margin="0,5,0,0"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource CyanBrush}"/>
                                            <TextBlock Text="FROM NEXUS"
                                                       Margin="0,2,0,0"
                                                       FontSize="8"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="6,0,0,0"
                                            Padding="12"
                                            Background="#14192E"
                                            CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock Text="DAILY REMAINING"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock x:Name="NexusDailyRemainingText"
                                                       Text="UNKNOWN"
                                                       Margin="0,5,0,0"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource CyanBrush}"/>
                                            <TextBlock Text="FROM NEXUS"
                                                       Margin="0,2,0,0"
                                                       FontSize="8"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="LAST REQUEST"
                                               VerticalAlignment="Center"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>

                                    <TextBlock x:Name="NexusLastRequestText"
                                               Grid.Column="1"
                                               Text="NONE YET"
                                               Margin="12,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#C7C3D6"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="13,8"
                            VerticalAlignment="Top"
                            Background="#2A1830"
                            BorderBrush="{StaticResource PinkBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock Text="TESTING ONLY"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Personal keys let us test the Nexus connection before Limelight receives its public app registration. -->
            <Border Margin="0,16,0,0"
                    Padding="24"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="NEXUS MODS ACCOUNT"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="NexusConnectionStatusText"
                                   Text="NOT CONNECTED"
                                   Margin="0,10,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>

                        <TextBlock x:Name="NexusAccountDetailText"
                                   Text="Connect a personal API key to test browsing and downloads inside Limelight."
                                   Margin="0,7,20,0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                        <Border Margin="0,18,0,0"
                                Padding="16"
                                Background="{StaticResource RaisedPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">

                            <StackPanel>
                                <TextBlock Text="PERSONAL API KEY"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <PasswordBox x:Name="NexusApiKeyBox"
                                                 MinWidth="320"
                                                 Height="38"
                                                 Padding="11,8"
                                                 VerticalContentAlignment="Center"
                                                 Background="#0D1020"
                                                 Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 BorderThickness="1"
                                                 CaretBrush="{StaticResource CyanBrush}"
                                                 PasswordChar="●"/>

                                    <Button x:Name="NexusConnectButton"
                                            Grid.Column="1"
                                            Content="CONNECT"
                                            MinWidth="100"
                                            Margin="12,0,0,0"
                                            Click="NexusConnectButton_Click"
                                            Style="{StaticResource PrimaryButton}"/>

                                    <Button x:Name="NexusDisconnectButton"
                                            Grid.Column="2"
                                            Content="DISCONNECT"
                                            MinWidth="112"
                                            Margin="10,0,0,0"
                                            IsEnabled="False"
                                            Opacity="0.45"
                                            Click="NexusDisconnectButton_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                </Grid>

                                <TextBlock Text="Your key will stay on this Windows account. Limelight will never include it in diagnostic reports."
                                           Margin="0,10,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="13,8"
                            VerticalAlignment="Top"
                            Background="#1A1E35"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                        <TextBlock x:Name="NexusAccessBadgeText"
                                   Text="TESTING ACCESS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <Border Margin="0,16,0,0"
                    Padding="24"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="LIVE SESSION"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="SessionStatusText"
                                       Text="IDLE"
                                       Margin="0,10,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                        </StackPanel>

                        <TextBlock x:Name="MountedContainerText"
                                   Grid.Column="1"
                                   Text="0 / 12 CONTAINERS"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CyanBrush}"/>
                    </Grid>

                    <TextBlock x:Name="SessionDetailText"
                               Text="Start the game to begin a live session."
                               Margin="0,10,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <TextBlock x:Name="StagingText"
                               Text="No staged files are waiting for cleanup."
                               Margin="0,7,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Padding="24"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <StackPanel>
                    <TextBlock Text="RECOVERY TOOLS"
                               FontSize="12"
                               FontWeight="Bold"/>

                    <TextBlock Text="Repair refreshes Limelight's managed bridge and clears stale staging files. It is only available while the game is closed."
                               Margin="0,10,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <StackPanel Margin="0,18,0,0"
                                Orientation="Horizontal">

                        <Button x:Name="RepairButton"
                                Content="REPAIR LIVE LOADER"
                                Click="RepairButton_Click"
                                Style="{StaticResource PrimaryButton}"/>

                        <Button Content="EXPORT DIAGNOSTIC REPORT"
                                Margin="12,0,0,0"
                                Click="ExportButton_Click"
                                Style="{StaticResource SecondaryButton}"/>

                        <Button x:Name="NativeTestButton"
                                Content="NATIVE TEST"
                                Margin="12,0,0,0"
                                Click="NativeTestButton_Click"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
