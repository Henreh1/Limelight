<UserControl x:Class="Limelight.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Bahnschrift, Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="38,30">
            <TextBlock Text="SETTINGS"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{StaticResource CyanBrush}"/>

            <TextBlock Text="KEEP THE SHOW RUNNING"
                       Margin="0,5,0,0"
                       FontSize="27"
                       FontWeight="Bold"/>

            <TextBlock Text="Check Limelight's live session, repair managed loader files, or prepare a private diagnostic report."
                       Margin="0,8,0,0"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"/>

            <Border Margin="0,28,0,0"
                    Padding="24"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="GAME CONNECTION"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="GameConnectionStatusText"
                                   Text="NOT CONNECTED"
                                   Margin="0,10,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>

                        <TextBlock x:Name="GameConnectionDetailText"
                                   Text="Choose the Dead as Disco installation folder."
                                   Margin="0,7,20,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                        <Button x:Name="ChangeGameFolderButton"
                                Content="CHANGE GAME FOLDER"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                Click="ChangeGameFolderButton_Click"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="13,8"
                            VerticalAlignment="Top"
                            Background="#1A1E35"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                        <TextBlock x:Name="GameRunningBadgeText"
                                   Text="NOT RUNNING"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- This card keeps the private testing boundary obvious before anybody connects a personal key. -->
            <Border Margin="0,16,0,0"
                    Padding="24"
                    Background="#17152A"
                    BorderBrush="{StaticResource PinkBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="NEXUS API TEST PROGRAM"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>

                        <TextBlock Text="PRIVATE TESTING BUILD"
                                   Margin="0,9,0,0"
                                   FontSize="19"
                                   FontWeight="Bold"/>

                        <TextBlock Margin="0,8,24,0"
                                   MaxWidth="820"
                                   Text="This build uses personal API keys only for private development and registration testing. Do not distribute it as a public Nexus-enabled release until Nexus Mods has reviewed and registered Limelight."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                        <UniformGrid Margin="0,19,0,0"
                                     Columns="2">
                            <Border Margin="0,0,7,7"
                                    Padding="14"
                                    Background="#111528"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="REQUEST IDENTITY"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="LIMELIGHT 0.1.0"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="7,0,0,7"
                                    Padding="14"
                                    Background="#111528"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="CREDENTIAL STORAGE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="THIS WINDOWS ACCOUNT ONLY"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,7,7,0"
                                    Padding="14"
                                    Background="#111528"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="CATALOGUE CACHE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="15 MINUTES"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CyanBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="7,7,0,0"
                                    Padding="14"
                                    Background="#21172C"
                                    BorderBrush="#6B3158"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="REGISTRATION STATUS"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="NOT SUBMITTED"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Margin="0,17,20,0"
                                   Text="Before public distribution: submit the test build, Limelight name, description and dark-background logo to Nexus Mods, then replace personal-key onboarding with the registered application flow."
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   LineHeight="17"
                                   Foreground="#C7C3D6"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="13,8"
                            VerticalAlignment="Top"
                            Background="#2A1830"
                            BorderBrush="{StaticResource PinkBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock Text="TESTING ONLY"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Personal keys let us test the Nexus connection before Limelight receives its public app registration. -->
            <Border Margin="0,16,0,0"
                    Padding="24"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="NEXUS MODS ACCOUNT"
                                   FontSize="12"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="NexusConnectionStatusText"
                                   Text="NOT CONNECTED"
                                   Margin="0,10,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>

                        <TextBlock x:Name="NexusAccountDetailText"
                                   Text="Connect a personal API key to test browsing and downloads inside Limelight."
                                   Margin="0,7,20,0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                        <Border Margin="0,18,0,0"
                                Padding="16"
                                Background="{StaticResource RaisedPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">

                            <StackPanel>
                                <TextBlock Text="PERSONAL API KEY"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <PasswordBox x:Name="NexusApiKeyBox"
                                                 MinWidth="320"
                                                 Height="38"
                                                 Padding="11,8"
                                                 VerticalContentAlignment="Center"
                                                 Background="#0D1020"
                                                 Foreground="{StaticResource TextBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 BorderThickness="1"
                                                 CaretBrush="{StaticResource CyanBrush}"
                                                 PasswordChar="●"/>

                                    <Button x:Name="NexusConnectButton"
                                            Grid.Column="1"
                                            Content="CONNECT"
                                            MinWidth="100"
                                            Margin="12,0,0,0"
                                            Click="NexusConnectButton_Click"
                                            Style="{StaticResource PrimaryButton}"/>

                                    <Button x:Name="NexusDisconnectButton"
                                            Grid.Column="2"
                                            Content="DISCONNECT"
                                            MinWidth="112"
                                            Margin="10,0,0,0"
                                            IsEnabled="False"
                                            Opacity="0.45"
                                            Click="NexusDisconnectButton_Click"
                                            Style="{StaticResource SecondaryButton}"/>
                                </Grid>

                                <TextBlock Text="Your key will stay on this Windows account. Limelight will never include it in diagnostic reports."
                                           Margin="0,10,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="13,8"
                            VerticalAlignment="Top"
                            Background="#1A1E35"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                        <TextBlock x:Name="NexusAccessBadgeText"
                                   Text="TESTING ACCESS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PinkBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <Border Margin="0,16,0,0"
                    Padding="24"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="LIVE SESSION"
                                       FontSize="12"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="SessionStatusText"
                                       Text="IDLE"
                                       Margin="0,10,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                        </StackPanel>

                        <TextBlock x:Name="MountedContainerText"
                                   Grid.Column="1"
                                   Text="0 / 12 CONTAINERS"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CyanBrush}"/>
                    </Grid>

                    <TextBlock x:Name="SessionDetailText"
                               Text="Start the game to begin a live session."
                               Margin="0,10,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <TextBlock x:Name="StagingText"
                               Text="No staged files are waiting for cleanup."
                               Margin="0,7,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Padding="24"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">

                <StackPanel>
                    <TextBlock Text="RECOVERY TOOLS"
                               FontSize="12"
                               FontWeight="Bold"/>

                    <TextBlock Text="Repair refreshes Limelight's managed bridge and clears stale staging files. It is only available while the game is closed."
                               Margin="0,10,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <StackPanel Margin="0,18,0,0"
                                Orientation="Horizontal">

                        <Button x:Name="RepairButton"
                                Content="REPAIR LIVE LOADER"
                                Click="RepairButton_Click"
                                Style="{StaticResource PrimaryButton}"/>

                        <Button Content="EXPORT DIAGNOSTIC REPORT"
                                Margin="12,0,0,0"
                                Click="ExportButton_Click"
                                Style="{StaticResource SecondaryButton}"/>

                        <Button x:Name="NativeTestButton"
                                Content="NATIVE TEST"
                                Margin="12,0,0,0"
                                Click="NativeTestButton_Click"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
