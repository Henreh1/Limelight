<UserControl x:Class="Limelight.Views.NexusModDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Bahnschrift, Segoe UI">

    <UserControl.Resources>
        <Style x:Key="CarouselArrowButton"
               TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Background" Value="#DB111528"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#80343A59"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ArrowBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ArrowBackground"
                                        Property="Background"
                                        Value="#F02A203C"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource PinkBrush}"/>
                                <Setter Property="BorderBrush"
                                        Value="{StaticResource PinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CarouselThumbnailButton"
               TargetType="Button">
            <Setter Property="Width" Value="126"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{StaticResource RaisedPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ThumbnailBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                ClipToBounds="True">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbnailBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PinkBrush}"/>
                                <Setter Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailStatCard"
               TargetType="Border">
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="38,26,38,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackToSearchButton"
                    MinWidth="142"
                    Content="&#x2039;  BACK TO SEARCH"
                    Style="{StaticResource SecondaryButton}"/>

            <StackPanel Grid.Column="1"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="NEXUS MOD SPOTLIGHT"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyanBrush}"/>

                <TextBlock Text="DETAILS, MEDIA AND DOWNLOADS"
                           Margin="0,3,0,0"
                           FontSize="21"
                           FontWeight="Bold"/>
            </StackPanel>

            <Border Grid.Column="2"
                    Padding="13,8"
                    VerticalAlignment="Top"
                    Background="#1A1E35"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="NEXUS CONNECTED"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyanBrush}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="DetailsScrollViewer"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar"
                           BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
                </ScrollViewer.Resources>

                <StackPanel Margin="38,0,38,34">
                    <!-- The main image changes in place while the strip keeps every available shot close by. -->
                    <Border Height="320"
                            Background="{StaticResource RaisedPanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="L"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="92"
                                       FontWeight="Black"
                                       FontStyle="Italic"
                                       Foreground="#343A59"/>

                            <Image x:Name="HeroImage"
                                   Stretch="UniformToFill"/>

                            <Rectangle VerticalAlignment="Bottom"
                                       Height="190">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0"
                                                         EndPoint="0.5,1">
                                        <GradientStop Offset="0"
                                                      Color="#00101322"/>
                                        <GradientStop Offset="0.55"
                                                      Color="#CC101322"/>
                                        <GradientStop Offset="1"
                                                      Color="#FF101322"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Border Margin="22"
                                    Padding="10,6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#E61A1E35"
                                    BorderBrush="{StaticResource CyanBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock x:Name="CategoryText"
                                           Text="DEAD AS DISCO"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}"/>
                            </Border>

                            <StackPanel Margin="28,0,28,25"
                                        VerticalAlignment="Bottom">
                                <TextBlock x:Name="ModNameText"
                                           Text="NEXUS MOD"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock x:Name="ModMetaText"
                                           Margin="0,7,0,0"
                                           Text="BY UNKNOWN AUTHOR  •  VERSION UNKNOWN"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>

                            <Button x:Name="PreviousImageButton"
                                    Margin="18,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="4"
                                    Content="&#x2039;"
                                    ToolTip="Previous image"
                                    Style="{StaticResource CarouselArrowButton}"/>

                            <Button x:Name="NextImageButton"
                                    Margin="0,0,18,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="4"
                                    Content="&#x203A;"
                                    ToolTip="Next image"
                                    Style="{StaticResource CarouselArrowButton}"/>

                            <Border Margin="0,0,22,20"
                                    Padding="10,5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Panel.ZIndex="4"
                                    Background="#E6141728"
                                    BorderBrush="#80343A59"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock x:Name="ImageCounterText"
                                           Text="1 / 1"
                                           FontSize="11"
                                           FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="CarouselPanel"
                            Margin="0,12,0,0"
                            Padding="12"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      PanningMode="HorizontalOnly">
                            <ItemsControl x:Name="CarouselThumbnailsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}"
                                                Style="{StaticResource CarouselThumbnailButton}">
                                            <Image Source="{Binding}"
                                                   Stretch="UniformToFill"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Margin="0,0,6,0"
                                Style="{StaticResource DetailStatCard}">
                            <StackPanel>
                                <TextBlock Text="DOWNLOADS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="DownloadCountText"
                                           Margin="0,5,0,0"
                                           Text="0"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Margin="6,0"
                                Style="{StaticResource DetailStatCard}">
                            <StackPanel>
                                <TextBlock Text="ENDORSEMENTS"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="EndorsementCountText"
                                           Margin="0,5,0,0"
                                           Text="0"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Margin="6,0,0,0"
                                Style="{StaticResource DetailStatCard}">
                            <StackPanel>
                                <TextBlock Text="MOD ID"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="ModIdText"
                                           Margin="0,5,0,0"
                                           Text="0"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PinkBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Margin="0,0,16,0"
                                Padding="24"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <StackPanel>
                                <TextBlock Text="ABOUT THIS MOD"
                                           FontSize="14"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="SummaryText"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           LineHeight="20"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <Border Height="1"
                                        Margin="0,20"
                                        Background="{StaticResource BorderBrush}"/>

                                <!-- Cleaned paragraphs from the author's Nexus description are added here. -->
                                <StackPanel x:Name="DescriptionContentPanel"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <Border Padding="20"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <StackPanel>
                                    <TextBlock Text="REQUIREMENTS"
                                               FontSize="13"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="NoRequirementsText"
                                               Margin="0,10,0,0"
                                               Text="No additional requirements were listed."
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               LineHeight="18"
                                               Foreground="{StaticResource MutedTextBrush}"/>

                                    <ItemsControl x:Name="RequirementsList"
                                                  Margin="0,8,0,0"
                                                  Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0"
                                    Padding="20"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <StackPanel>
                                    <TextBlock Text="READY TO INSTALL?"
                                               FontSize="13"
                                               FontWeight="Bold"/>

                                    <TextBlock Margin="0,8,0,16"
                                               Text="Review the available versions before choosing a download."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               LineHeight="17"
                                               Foreground="{StaticResource MutedTextBrush}"/>

                                    <Button x:Name="ViewFilesButton"
                                            Content="VIEW FILES"
                                            Style="{StaticResource PrimaryButton}"/>

                                    <Button x:Name="OpenNexusButton"
                                            Margin="0,9,0,0"
                                            Content="OPEN ON NEXUS"
                                            Style="{StaticResource SecondaryButton}"/>

                                    <TextBlock Margin="2,10,2,0"
                                               Text="Open the Nexus page to see the complete image gallery, posts and any extra details from the author."
                                               TextWrapping="Wrap"
                                               FontSize="10"
                                               LineHeight="15"
                                               Foreground="{StaticResource MutedTextBrush}"/>

                                    <!-- The hidden control keeps the current code-behind compatible while the duplicate action stays out of the UI. -->
                                    <Button x:Name="OpenGalleryButton"
                                            Visibility="Collapsed"
                                            Content="OPEN FULL GALLERY"
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="LoadingPanel"
                        Width="450"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="SETTING THE STAGE"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Margin="0,8,0,18"
                           Text="Limelight is getting the full mod page from Nexus."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <ProgressBar Height="7"
                             IsIndeterminate="True"
                             Foreground="{StaticResource PinkBrush}"/>
            </StackPanel>

            <StackPanel x:Name="ErrorPanel"
                        Width="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="&#x25C7;"
                           HorizontalAlignment="Center"
                           FontSize="36"
                           Foreground="{StaticResource PinkBrush}"/>
                <TextBlock Margin="0,8,0,0"
                           Text="THE MOD PAGE MISSED ITS CUE"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock x:Name="ErrorText"
                           Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
