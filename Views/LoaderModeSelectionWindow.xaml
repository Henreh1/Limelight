<Window x:Class="Limelight.Views.LoaderModeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="790"
        Height="510"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Bahnschrift, Segoe UI">

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="13">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#111425"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="13,13,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,8,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#x25C6;"
                                   Margin="0,0,10,0"
                                   FontSize="10"
                                   Foreground="{StaticResource PinkBrush}"/>
                        <TextBlock Text="CHOOSE A LIVE LOADER"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <Button Content="&#x00D7;"
                            Width="32"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="Cancel_Click"
                            Style="{StaticResource NavigationButton}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="32,27,32,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="LIGHTS UP. YOUR WAY."
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Choose how Limelight should handle character changes for this game session."
                               Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <UniformGrid Grid.Row="1"
                             Margin="0,24,0,20"
                             Columns="2">
                    <Button Margin="0,0,8,0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Click="NormalLoader_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Card"
                                        Padding="22"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Card"
                                                Property="BorderBrush"
                                                Value="{StaticResource CyanBrush}"/>
                                        <Setter TargetName="Card"
                                                Property="Background"
                                                Value="#172235"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Width="54"
                                    Height="54"
                                    HorizontalAlignment="Left"
                                    Background="#172B3B"
                                    BorderBrush="{StaticResource CyanBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <TextBlock Text="L"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="27"
                                           FontWeight="Bold"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextBrush}"/>
                            </Border>

                            <StackPanel Grid.Row="1"
                                        Margin="0,18,0,16">
                                <TextBlock Text="LIVE LOADER"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Use the active mod and control every change from Limelight's library."
                                           Margin="0,7,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="18"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Text="SELECT NORMAL"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyanBrush}"/>
                        </Grid>
                    </Button>

                    <Button Margin="8,0,0,0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Click="X19Loader_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Card"
                                        Padding="22"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Card"
                                                Property="BorderBrush"
                                                Value="{StaticResource PinkBrush}"/>
                                        <Setter TargetName="Card"
                                                Property="Background"
                                                Value="#261A33"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Border Width="54"
                                        Height="54"
                                        HorizontalAlignment="Left"
                                        Background="#30203B"
                                        BorderBrush="{StaticResource PinkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <TextBlock Text="X"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="27"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                </Border>

                                <Border Padding="10,6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#30203B"
                                        CornerRadius="7">
                                    <TextBlock x:Name="X19CountText"
                                               Text="0 MODS"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Margin="0,18,0,16">
                                <TextBlock Text="X19 LLOADER"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="X19DescriptionText"
                                           Text="Cycle through your selected character group using the configured global hotkey."
                                           Margin="0,7,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="18"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>

                            <TextBlock x:Name="X19ActionText"
                                       Grid.Row="2"
                                       Text="SELECT X19"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                        </Grid>
                    </Button>
                </UniformGrid>

                <Border x:Name="EmptyGroupPrompt"
                        Grid.Row="2"
                        Padding="14"
                        Background="#21172C"
                        BorderBrush="{StaticResource PinkBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="X19 NEEDS A GROUP"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                            <TextBlock Text="Choose at least one character before launching this mode."
                                       Margin="0,4,16,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="SELECT MODS"
                                Click="ConfigureX19_Click"
                                Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
