<Window x:Class="Limelight.Views.LoaderModeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:motion="clr-namespace:Limelight.Animations"
        Width="1060"
        Height="510"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Bahnschrift, Segoe UI"
        motion:WindowMotion.AnimateClose="True">

    <Window.Resources>
        <Style x:Key="SelectorTitleBarButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="46"/>
            <Setter Property="Height"
                    Value="42"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource PinkBrush}"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Opacity"
                            Value="0.72"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource AnimatedDialogCardStyle}"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="13">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#0C0E1D"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="13,13,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="18,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#x25C6;"
                                   Margin="0,0,10,0"
                                   FontSize="10"
                                   Foreground="{StaticResource PinkBrush}"/>
                        <TextBlock Text="CHOOSE A LIVE LOADER"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource SelectorTitleBarButtonStyle}"
                            Click="Cancel_Click"
                            ToolTip="Close">

                        <Path Width="11"
                              Height="11"
                              Data="M 0.8,0.8 L 10.2,10.2 M 10.2,0.8 L 0.8,10.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeThickness="1.4"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="32,27,32,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="LIGHTS UP. YOUR WAY."
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Choose how Limelight should handle character changes for this game session."
                               Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <UniformGrid Grid.Row="1"
                             Margin="0,24,0,20"
                             Columns="3">
                    <Button x:Name="NormalLoaderButton"
                            Margin="0,0,8,0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Click="NormalLoader_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Card"
                                        Padding="22"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Card"
                                                Property="BorderBrush"
                                                Value="{StaticResource CyanBrush}"/>
                                        <Setter TargetName="Card"
                                                Property="Background"
                                                Value="#172235"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Width="54"
                                    Height="54"
                                    HorizontalAlignment="Left"
                                    Background="#172B3B"
                                    BorderBrush="{StaticResource CyanBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <TextBlock Text="L"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="27"
                                           FontWeight="Bold"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextBrush}"/>
                            </Border>

                            <StackPanel Grid.Row="1"
                                        Margin="0,18,0,16">
                                <TextBlock Text="LIVE LOADER"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Use the active mod and control every change from Limelight's library."
                                           Margin="0,7,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="18"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Text="SELECT NORMAL"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyanBrush}"/>
                        </Grid>
                    </Button>

                    <Button x:Name="X19LoaderButton"
                            Margin="8,0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Click="X19Loader_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Card"
                                        Padding="22"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Card"
                                                Property="BorderBrush"
                                                Value="{StaticResource PinkBrush}"/>
                                        <Setter TargetName="Card"
                                                Property="Background"
                                                Value="#261A33"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Border Width="54"
                                        Height="54"
                                        HorizontalAlignment="Left"
                                        Background="#30203B"
                                        BorderBrush="{StaticResource PinkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <TextBlock Text="X"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="27"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                </Border>

                                <Border Padding="10,6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#30203B"
                                        CornerRadius="7">
                                    <TextBlock x:Name="X19CountText"
                                               Text="0 MODS"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PinkBrush}"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Margin="0,18,0,16">
                                <TextBlock Text="X19 LLOADER"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="X19DescriptionText"
                                           Text="Cycle through your selected character group using the configured global hotkey."
                                           Margin="0,7,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="18"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>

                            <TextBlock x:Name="X19ActionText"
                                       Grid.Row="2"
                                       Text="SELECT X19"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                        </Grid>
                    </Button>

                    <Button Margin="8,0,0,0"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Click="NoLiveLoader_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Card"
                                        Padding="22"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Card"
                                                Property="BorderBrush"
                                                Value="{StaticResource PinkBrush}"/>
                                        <Setter TargetName="Card"
                                                Property="Background"
                                                Value="#21172C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Width="54"
                                    Height="54"
                                    HorizontalAlignment="Left"
                                    Background="#21172C"
                                    BorderBrush="{StaticResource PinkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <TextBlock Text="&#x23FB;"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="25"
                                           Foreground="{StaticResource PinkBrush}"/>
                            </Border>

                            <StackPanel Grid.Row="1"
                                        Margin="0,18,0,16">
                                <TextBlock Text="NO LIVE LOADER"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Play with the deployed mod while skipping live switching, loader scans, overlays, and X19 controls."
                                           Margin="0,7,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="18"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Text="LAUNCH LIGHTWEIGHT"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                        </Grid>
                    </Button>
                </UniformGrid>

                <Border x:Name="EmptyGroupPrompt"
                        Grid.Row="2"
                        Padding="14"
                        Background="#21172C"
                        BorderBrush="{StaticResource PinkBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="X19 NEEDS A GROUP"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                            <TextBlock Text="Choose at least one character before launching this mode."
                                       Margin="0,4,16,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="SELECT MODS"
                                Click="ConfigureX19_Click"
                                Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </Border>

                <Border x:Name="CompatibilityPrompt"
                        Grid.Row="2"
                        Padding="14"
                        Background="#21172C"
                        BorderBrush="{StaticResource PinkBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="LIVE LOADER UPDATE REQUIRED"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                            <TextBlock x:Name="CompatibilityPromptText"
                                       Margin="0,4,16,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="OPEN SUPPORT"
                                Click="OpenSupport_Click"
                                Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
