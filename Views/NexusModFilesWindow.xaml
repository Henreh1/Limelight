<Window x:Class="Limelight.Views.NexusModFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a Nexus file"
        Width="1040"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Bahnschrift, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="FileScrollThumbStyle"
               TargetType="Thumb">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="#343A59"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBackground"
                                Margin="2,1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"/>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBackground"
                                        Property="Background"
                                        Value="#9A2B76"/>
                            </Trigger>

                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBackground"
                                        Property="Background"
                                        Value="{StaticResource PinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileScrollBarStyle"
               TargetType="ScrollBar">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Background" Value="#0E1121"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="True"
                                   Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FileScrollThumbStyle}"/>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowIconButton"
               TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="IconBackground"
                                        Property="Background"
                                        Value="#2A203C"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource PinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Direction="270"
                              ShadowDepth="7"
                              Color="#000000"
                              Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <!-- The custom title bar keeps the file picker inside Limelight's visual language. -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Padding="18,0,10,0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Background="#22263F"
                            CornerRadius="5">
                        <TextBlock Text="◆"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{StaticResource PinkBrush}"/>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="NEXUS MOD FILES"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>

                    <Button x:Name="CloseButton"
                            Grid.Column="2"
                            Content="×"
                            ToolTip="Close"
                            Style="{StaticResource WindowIconButton}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="28,24,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Mod information stays visible while the user compares available files. -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="146"
                            Height="92"
                            HorizontalAlignment="Left"
                            Background="{StaticResource RaisedPanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">

                        <Grid>
                            <TextBlock Text="N"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="38"
                                       FontWeight="Black"
                                       FontStyle="Italic"
                                       Foreground="{StaticResource PinkBrush}"/>

                            <Image x:Name="ModPicture"
                                   Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="CHOOSE A VERSION"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CyanBrush}"/>

                        <TextBlock x:Name="ModNameText"
                                   Margin="0,5,0,0"
                                   Text="SELECTED NEXUS MOD"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock x:Name="ModDetailText"
                                   Margin="0,6,0,0"
                                   Text="Limelight is preparing this mod's available downloads."
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="{StaticResource BorderBrush}"/>

                <Grid Grid.Row="2"
                      Margin="0,20,0,0">

                    <!-- Loading is the first state shown while Nexus returns the file list. -->
                    <StackPanel x:Name="LoadingPanel"
                                Width="430"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="GETTING THE FILE LIST"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Margin="0,8,0,18"
                                   Text="Limelight is asking Nexus which versions are ready for the stage."
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                        <ProgressBar Height="7"
                                     IsIndeterminate="True"
                                     Background="{StaticResource RaisedPanelBrush}"
                                     BorderThickness="0"
                                     Foreground="{StaticResource PinkBrush}"/>
                    </StackPanel>

                    <!-- The empty and error panels use the same space as the file list. -->
                    <StackPanel x:Name="EmptyPanel"
                                Width="500"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="◇"
                                   HorizontalAlignment="Center"
                                   FontSize="34"
                                   Foreground="{StaticResource PinkBrush}"/>

                        <TextBlock Margin="0,8,0,0"
                                   Text="NO DOWNLOADS AVAILABLE"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Margin="0,8,0,0"
                                   Text="This mod does not currently have a downloadable file on Nexus."
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <StackPanel x:Name="ErrorPanel"
                                Width="540"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="◇"
                                   HorizontalAlignment="Center"
                                   FontSize="34"
                                   Foreground="{StaticResource PinkBrush}"/>

                        <TextBlock Margin="0,8,0,0"
                                   Text="THE FILE LIST MISSED ITS CUE"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="ErrorText"
                                   Margin="0,8,0,0"
                                   Text="Limelight could not load the available files."
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <ScrollViewer x:Name="FilesScrollViewer"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource FileScrollBarStyle}"/>
                        </ScrollViewer.Resources>

                        <ItemsControl x:Name="FilesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,12"
                                            Padding="18"
                                            Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,24,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Padding="8,4"
                                                            Background="#25203B"
                                                            CornerRadius="4">
                                                        <TextBlock Text="{Binding CategoryName}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource PinkBrush}"/>
                                                    </Border>

                                                    <TextBlock Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding VersionLabel}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource CyanBrush}"/>
                                                </StackPanel>

                                                <TextBlock Margin="0,9,0,0"
                                                           Text="{Binding FileName}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextBrush}"/>

                                                <TextBlock Margin="0,7,0,0"
                                                           Text="{Binding Description}"
                                                           MaxHeight="42"
                                                           FontSize="12"
                                                           LineHeight="18"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource MutedTextBrush}"/>

                                                <StackPanel Margin="0,12,0,0"
                                                            Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SizeLabel}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource MutedTextBrush}"/>

                                                    <TextBlock Margin="9,0"
                                                               Text="◆"
                                                               FontSize="7"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource BorderBrush}"/>

                                                    <TextBlock Text="{Binding UploadedLabel}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource MutedTextBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button x:Name="DownloadFileButton"
                                                    Grid.Column="1"
                                                    MinWidth="156"
                                                    Padding="17,11"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Content="DOWNLOAD"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource PrimaryButton}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Padding="28,0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource CyanBrush}"/>

                        <TextBlock x:Name="FooterStatusText"
                                   Margin="9,0,0,0"
                                   Text="Choose the file you want Limelight to install."
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <Button x:Name="CancelButton"
                            Grid.Column="1"
                            MinWidth="104"
                            Content="CANCEL"
                            Style="{StaticResource SecondaryButton}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
