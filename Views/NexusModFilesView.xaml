<UserControl x:Class="Limelight.Views.NexusModFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Bahnschrift, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="38,26,38,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackToModButton"
                    MinWidth="132"
                    Content="&#x2039;  BACK TO MOD"
                    Style="{StaticResource SecondaryButton}"/>

            <StackPanel Grid.Column="1"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="NEXUS MOD FILES"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyanBrush}"/>

                <TextBlock Text="CHOOSE YOUR VERSION"
                           Margin="0,3,0,0"
                           FontSize="21"
                           FontWeight="Bold"/>
            </StackPanel>

            <Border Grid.Column="2"
                    Padding="13,8"
                    VerticalAlignment="Top"
                    Background="#1A1E35"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="DOWNLOAD STAGE"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource PinkBrush}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="FilesScrollViewer"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar"
                           BasedOn="{StaticResource NexusVerticalScrollBarStyle}"/>
                </ScrollViewer.Resources>

                <StackPanel Margin="38,0,38,30">
                    <!-- This header stays with the files so the chosen mod is always obvious. -->
                    <Border Padding="20"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="76"
                                    Height="76"
                                    Background="{StaticResource RaisedPanelBrush}"
                                    BorderBrush="{StaticResource PinkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="N"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               FontStyle="Italic"
                                               Foreground="{StaticResource PinkBrush}"/>

                                    <Image x:Name="ModPicture"
                                           Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="ModNameText"
                                           Text="NEXUS MOD"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock x:Name="ModDetailText"
                                           Margin="0,7,0,0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="2,20,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="AVAILABLE FILES"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="FileCountText"
                                   Grid.Column="1"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CyanBrush}"/>
                    </Grid>

                    <ItemsControl x:Name="FilesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12"
                                        Padding="20"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Padding="9,4"
                                                        Background="#242842"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="5">
                                                    <TextBlock Text="{Binding CategoryName}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource CyanBrush}"/>
                                                </Border>

                                                <Border Margin="8,0,0,0"
                                                        Padding="9,4"
                                                        Background="#2A203D"
                                                        BorderBrush="#603A3154"
                                                        BorderThickness="1"
                                                        CornerRadius="5">
                                                    <TextBlock Text="PRIMARY"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource PinkBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding FileName}"
                                                       Margin="0,11,0,0"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Description}"
                                                       MaxWidth="760"
                                                       Margin="0,7,0,0"
                                                       FontSize="12"
                                                       LineHeight="18"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedTextBrush}"/>

                                            <StackPanel Margin="0,12,0,0"
                                                        Orientation="Horizontal">
                                                <TextBlock Text="{Binding VersionLabel}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource CyanBrush}"/>
                                                <TextBlock Text="  •  "
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding SizeLabel}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="  •  "
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding UploadedLabel}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button x:Name="DownloadFileButton"
                                                Grid.Column="1"
                                                MinWidth="118"
                                                Margin="22,0,0,0"
                                                VerticalAlignment="Center"
                                                Content="DOWNLOAD"
                                                Tag="{Binding}"
                                                Style="{StaticResource PrimaryButton}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="LoadingPanel"
                        Width="450"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="CHECKING THE FILE LIST"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Margin="0,8,0,18"
                           Text="Limelight is asking Nexus which versions are ready."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <ProgressBar Height="7"
                             IsIndeterminate="True"
                             Foreground="{StaticResource PinkBrush}"/>
            </StackPanel>

            <StackPanel x:Name="EmptyPanel"
                        Width="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="&#x25C7;"
                           HorizontalAlignment="Center"
                           FontSize="36"
                           Foreground="{StaticResource PinkBrush}"/>
                <TextBlock Margin="0,8,0,0"
                           Text="NO DOWNLOADABLE FILES"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Margin="0,9,0,0"
                           Text="Nexus did not return a main, update or optional file for this mod."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <StackPanel x:Name="ErrorPanel"
                        Width="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="&#x25C7;"
                           HorizontalAlignment="Center"
                           FontSize="36"
                           Foreground="{StaticResource PinkBrush}"/>
                <TextBlock Margin="0,8,0,0"
                           Text="THE FILE LIST MISSED ITS CUE"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock x:Name="ErrorText"
                           Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Padding="38,14"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FooterStatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"/>

                <ProgressBar x:Name="DownloadProgressBar"
                             Grid.Column="1"
                             Width="190"
                             Height="6"
                             Margin="20,0,0,0"
                             VerticalAlignment="Center"
                             Minimum="0"
                             Maximum="100"
                             Foreground="{StaticResource CyanBrush}"
                             Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
