<Window x:Class="Limelight.Views.LiveModSwitchingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limelight Live Loader"
        Width="430"
        Height="164"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        FontFamily="Bahnschrift, Segoe UI"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <Style x:Key="OverlayProgressBarStyle"
               TargetType="ProgressBar">
            <Setter Property="Height"
                    Value="7"/>
            <Setter Property="Background"
                    Value="#252943"/>
            <Setter Property="Foreground"
                    Value="{StaticResource CyanBrush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">

                            <Grid x:Name="PART_Track"
                                  ClipToBounds="True">

                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="4"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- I keep this card click-through so it never steals control from the game. -->
    <Border x:Name="PopupShell"
            Margin="10"
            Padding="18"
            Opacity="0"
            Background="#F20C0E1D"
            BorderBrush="#41486F"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              ShadowDepth="7"
                              Opacity="0.48"
                              Color="#050611"/>
        </Border.Effect>

        <Border.RenderTransform>
            <TranslateTransform x:Name="PopupTransform"
                                X="26"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- I preserve these names while the compact card presents only the
                 information that is useful during gameplay. -->
            <TextBlock x:Name="TimingNoteText"
                       Visibility="Collapsed"/>

            <Border x:Name="StatusIconContainer"
                    Grid.RowSpan="2"
                    Width="36"
                    Height="36"
                    Margin="0,1,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#252943"
                    CornerRadius="8">

                <TextBlock x:Name="StatusIcon"
                           Text="◆"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource CyanBrush}"/>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="PhaseText"
                           Text="PREPARING LIVE SWITCH"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyanBrush}"/>

                <TextBlock x:Name="ModNameText"
                           Text="SELECTED MOD"
                           Margin="0,4,0,0"
                           FontSize="15"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock x:Name="ProgressText"
                           Text="12%"
                           HorizontalAlignment="Right"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyanBrush}"/>

                <TextBlock x:Name="EtaText"
                           Text="CALCULATING"
                           Margin="0,3,0,0"
                           HorizontalAlignment="Right"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <TextBlock x:Name="DetailText"
                       Grid.Row="1"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Margin="0,7,0,0"
                       Text="Limelight is preparing the selected mod for a safe live change."
                       FontSize="11"
                       LineHeight="16"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource MutedTextBrush}"/>

            <ProgressBar x:Name="SwitchProgress"
                         Grid.Row="2"
                         Grid.ColumnSpan="3"
                         Minimum="0"
                         Maximum="100"
                         Value="12"
                         Margin="0,15,0,0"
                         Style="{StaticResource OverlayProgressBarStyle}"/>
        </Grid>
    </Border>
</Window>
