<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Limelight.ico</ApplicationIcon>
    <Version>0.1.0-early-access</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-early-access</InformationalVersion>
    <!-- CUE4Parse keeps its native helper in the same NuGet folder as the
         managed assembly. MSBuild may inspect that helper as managed code;
         the resulting notice is harmless because it is loaded natively. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3246</MSBuildWarningsAsMessages>
    <Configurations>Debug;Release;Test</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Limelight.ico" />

    <PackageReference Include="CUE4Parse" Version="1.2.2" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
    <PackageReference Include="SharpCompress" Version="0.50.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.6.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.7.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.8.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.9.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.10.dll" />
    <None Remove="Payloads\NativeBridge\LimelightNativeBridge-0.1.13.dll" />
    <None Remove="Payloads\NativeBridge\bridge-manifest.json" />

    <EmbeddedResource Include="Payloads\NativeBridge\LimelightNativeBridge-0.1.13.dll" LogicalName="Limelight.Payloads.NativeBridge.LimelightNativeBridge.dll" />

    <EmbeddedResource Include="Payloads\NativeBridge\bridge-manifest.json" LogicalName="Limelight.Payloads.NativeBridge.bridge-manifest.json" />
  </ItemGroup>

</Project>
