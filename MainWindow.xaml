<Window x:Class="Limelight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Limelight.Views"
        Title="Limelight — Dead as Disco Mod Manager"
        Width="1220"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Bahnschrift, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Limelight branding -->
                <StackPanel Margin="26,30,20,34">
                    <TextBlock Text="LIMELIGHT"
                               FontSize="27"
                               FontWeight="Black"
                               FontStyle="Italic"
                               Foreground="{StaticResource TextBrush}"/>

                    <Rectangle Width="68"
                               Height="3"
                               Margin="0,7,0,0"
                               HorizontalAlignment="Left"
                               Fill="{StaticResource PinkBrush}"/>

                    <TextBlock Text="DEAD AS DISCO MOD MANAGER"
                               Margin="0,10,0,0"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource CyanBrush}"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">

                    <Border x:Name="DashboardNavigation"
            Margin="8,3"
            Background="#25203B"
            CornerRadius="8"
            BorderBrush="{StaticResource PinkBrush}"
            BorderThickness="3,0,0,0"
            MouseLeftButtonDown="ShowDashboard_Click"
            Cursor="Hand">

                        <TextBlock x:Name="DashboardNavigationText"
                   Text="◆    Dashboard"
                   Padding="16,13"
                   FontSize="14"
                   Foreground="{StaticResource TextBrush}"/>
                    </Border>

                    <Border x:Name="MyModsNavigation"
            Margin="8,3"
            Background="Transparent"
            CornerRadius="8"
            BorderBrush="Transparent"
            BorderThickness="3,0,0,0"
            MouseLeftButtonDown="ShowMyMods_Click"
            Cursor="Hand">

                        <TextBlock x:Name="MyModsNavigationText"
                   Text="◇    My Mods"
                   Padding="16,13"
                   FontSize="14"
                   Foreground="{StaticResource MutedTextBrush}"/>
                    </Border>

                    <Button Content="◇    Browse Nexus"
            Style="{StaticResource NavigationButton}"/>

                    <Button Content="◇    Downloads"
            Style="{StaticResource NavigationButton}"/>

                    <Button Content="◇    Settings"
            Style="{StaticResource NavigationButton}"/>
                </StackPanel>

                <!-- Game connection status -->
                <Border Grid.Row="2"
                        Margin="16,16,16,22"
                        Padding="14"
                        Background="#111425"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">

                            <Ellipse x:Name="GameStatusDot"
                                     Width="8"
                                     Height="8"
                                     Margin="0,0,9,0"
                                     Fill="{StaticResource PinkBrush}"/>

                            <TextBlock x:Name="GameStatusTitle"
                                       Text="GAME NOT CONNECTED"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <TextBlock x:Name="GameStatusDescription"
                                   Text="Choose the Dead as Disco installation folder."
                                   Margin="17,7,0,0"
                                   FontSize="11"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Dashboard page -->
        <Grid x:Name="DashboardPage"
              Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Dashboard header -->
            <Grid Margin="34,24,34,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="DASHBOARD"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}"/>

                    <TextBlock Text="YOUR MODS. YOUR STAGE."
                               Margin="0,4,0,0"
                               FontSize="25"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button x:Name="ImportModButton"
                            Content="IMPORT MOD"
                            Click="ImportMod_Click"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"/>

                    <Button Content="LAUNCH GAME"
                            Click="LaunchGame_Click"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="34,0,34,34">

                    <!-- Main spotlight panel -->
                    <Border Padding="30"
                            CornerRadius="14"
                            BorderBrush="#413568"
                            BorderThickness="1">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">

                                <GradientStop Color="#261531"
                                              Offset="0"/>

                                <GradientStop Color="#141832"
                                              Offset="0.52"/>

                                <GradientStop Color="#102D35"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel MaxWidth="580"
                                        HorizontalAlignment="Left">

                                <TextBlock Text="READY FOR THE SPOTLIGHT?"
                                           FontSize="28"
                                           FontWeight="Black"/>

                                <TextBlock Text="Connect your game directory, install a character mod, and take control of the stage."
                                           Margin="0,10,0,20"
                                           FontSize="14"
                                           LineHeight="21"
                                           TextWrapping="Wrap"
                                           Foreground="#C8C6D8"/>

                                <StackPanel Orientation="Horizontal">

                                    <Button x:Name="ConnectGameButton"
                                            Content="CONNECT GAME"
                                            Click="ConnectGame_Click"
                                            Style="{StaticResource PrimaryButton}"/>

                                    <Button Content="BROWSE NEXUS"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Temporary Limelight artwork -->
                            <Border Grid.Column="1"
                                    Width="150"
                                    Height="150"
                                    Margin="30,0,0,0"
                                    Background="#18FFFFFF"
                                    BorderBrush="{StaticResource CyanBrush}"
                                    BorderThickness="1"
                                    CornerRadius="75">

                                <Grid>
                                    <Ellipse Margin="20"
                                             Stroke="{StaticResource PinkBrush}"
                                             StrokeThickness="3"/>

                                    <TextBlock Text="L"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="64"
                                               FontWeight="Black"
                                               FontStyle="Italic"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Dashboard statistics -->
                    <UniformGrid Columns="4"
             Margin="0,18,0,18">

                        <Border Margin="0,0,7,0"
            Padding="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="11">

                            <StackPanel>
                                <TextBlock Text="ACTIVE MODEL"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="ActiveModelText"
                       Text="NONE"
                       Margin="0,8,0,0"
                       FontSize="22"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource PinkBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="7,0"
            Padding="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="11">

                            <StackPanel>
                                <TextBlock Text="INSTALLED MODS"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="InstalledModCountText"
                       Text="0"
                       Margin="0,8,0,0"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource PinkBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="7,0"
            Padding="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="11">

                            <StackPanel>
                                <TextBlock Text="GAME STATUS"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="GameProcessStatusText"
                       Text="NOT RUNNING"
                       Margin="0,8,0,0"
                       FontSize="18"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource PinkBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="7,0,0,0"
            Padding="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="LIVE LOADER"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="{StaticResource MutedTextBrush}"/>

                                    <TextBlock x:Name="LiveLoaderStatusText"
                   Text="NOT INSTALLED"
                   Margin="0,8,0,0"
                   FontSize="18"
                   FontWeight="Bold"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource PinkBrush}"/>
                                </StackPanel>

                                <Button Grid.Column="1"
            Content="NATIVE TEST"
            Width="96"
            Height="32"
            Margin="8,0,0,0"
            Padding="0"
            VerticalAlignment="Center"
            Click="TestLiveLoader_Click"
            Style="{StaticResource SecondaryButton}"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- Library summary -->
                    <Border Padding="26"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="RECENTLY INSTALLED"
                                           FontSize="13"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="LibrarySummaryText"
                                           Text="Your mod library is empty. Import a ZIP archive or browse Nexus Mods to get started."
                                           Margin="0,10,20,0"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>

                            <TextBlock x:Name="LibraryStatusText"
                                       Grid.Column="1"
                                       Text="NO MODS YET"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PinkBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- My Mods occupies the same content area as the dashboard. -->
        <views:MyModsPage x:Name="MyModsPageControl"
                          Grid.Column="1"
                          Visibility="Collapsed"/>
    </Grid>
</Window>
