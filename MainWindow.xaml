<Window x:Class="Limelight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limelight — Dead as Disco Mod Manager"
        Width="1220"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Bahnschrift, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="262*"/>
            <ColumnDefinition Width="233*"/>
            <ColumnDefinition Width="480*"/>
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- logo -->
                <StackPanel Margin="26,30,20,34">
                    <TextBlock Text="LIMELIGHT"
                               FontSize="27"
                               FontWeight="Black"
                               FontStyle="Italic"
                               Foreground="{StaticResource TextBrush}"/>

                    <Rectangle Height="3"
                               Width="68"
                               Margin="0,7,0,0"
                               HorizontalAlignment="Left"
                               Fill="{StaticResource PinkBrush}"/>

                    <TextBlock Text="DEAD AS DISCO MOD MANAGER"
                               Margin="0,10,0,0"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource CyanBrush}"/>
                </StackPanel>

                <!-- navigation -->
                <StackPanel Grid.Row="1">

                    <Border Margin="8,3"
                            Background="#25203B"
                            CornerRadius="8"
                            BorderBrush="{StaticResource PinkBrush}"
                            BorderThickness="3,0,0,0">

                        <TextBlock Text="◆    Dashboard"
                                   Padding="16,13"
                                   FontSize="14"
                                   Foreground="{StaticResource TextBrush}"/>
                    </Border>

                    <Button Content="◇    My Mods"
                            Style="{StaticResource NavigationButton}"/>

                    <Button Content="◇    Browse Nexus"
                            Style="{StaticResource NavigationButton}"/>

                    <Button Content="◇    Downloads"
                            Style="{StaticResource NavigationButton}"/>

                    <Button Content="◇    Settings"
                            Style="{StaticResource NavigationButton}"/>
                </StackPanel>

                <!-- game connection status -->
                <Border Grid.Row="2"
                        Margin="16,16,16,22"
                        Padding="14"
                        Background="#111425"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="GameStatusDot"
             Width="8"
             Height="8"
             Margin="0,0,9,0"
             Fill="{StaticResource PinkBrush}"/>

                            <TextBlock x:Name="GameStatusTitle"
               Text="GAME NOT CONNECTED"
               FontSize="11"
               FontWeight="Bold"/>
                        </StackPanel>

                        <TextBlock x:Name="GameStatusDescription"
                                   Text="Please choose the Dead as Disco install location in settigns :D"
                                   Margin="17,7,0,0"
                                   FontSize="11"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- main area -->
        <Grid Grid.Column="1" Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Margin="34,24,34,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="DASHBOARD"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}"/>

                    <TextBlock Text="YOUR MODS. YOUR STAGE."
                               Margin="0,4,0,0"
                               FontSize="25"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ImportModButton"
                            Content="Import Mod"
                            Click="ImportMod_Click"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"/>

                    <Button Content="LAUNCH GAME"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="34,0,34,34">

                    <!-- hero panel -->
                    <Border Padding="30"
                            CornerRadius="14"
                            BorderBrush="#413568"
                            BorderThickness="1">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="#261531"
                                              Offset="0"/>
                                <GradientStop Color="#141832"
                                              Offset="0.52"/>
                                <GradientStop Color="#102D35"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel MaxWidth="580"
                                        HorizontalAlignment="Left">

                                <TextBlock Text="READY FOR THE SPOTLIGHT?"
                                           FontSize="28"
                                           FontWeight="Black"/>

                                <TextBlock Text="Connect your game directory, install a character mod, and take control of the stage."
                                           Margin="0,10,0,20"
                                           FontSize="14"
                                           LineHeight="21"
                                           TextWrapping="Wrap"
                                           Foreground="#C8C6D8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ConnectGameButton"
        Content="CONNECT GAME"
        Click="ConnectGame_Click"
        Style="{StaticResource PrimaryButton}"/>

                                    <Button Content="BROWSE NEXUS"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="150"
                                    Height="150"
                                    Margin="30,0,0,0"
                                    Background="#18FFFFFF"
                                    BorderBrush="{StaticResource CyanBrush}"
                                    BorderThickness="1"
                                    CornerRadius="75">

                                <Grid>
                                    <Ellipse Margin="20"
         Stroke="{StaticResource PinkBrush}"
         StrokeThickness="3"/>

                                    <TextBlock Text="L"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="64"
                                               FontWeight="Black"
                                               FontStyle="Italic"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- statistic cards -->
                    <UniformGrid Columns="3"
                                 Margin="0,18,0,18">

                        <Border Margin="0,0,9,0"
                                Padding="20"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11">

                            <StackPanel>
                                <TextBlock Text="ACTIVE MODEL"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock Text="NONE"
                                           Margin="0,8,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PinkBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="9,0"
                                Padding="20"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11">

                            <StackPanel>
                                <TextBlock Text="INSTALLED MODS"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock x:Name="InstalledModCountText"
                                           Text="0"
                                           Margin="0,8,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="9,0,0,0"
                                Padding="20"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11">

                            <StackPanel>
                                <TextBlock Text="LIVE LOADER"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <TextBlock Text="OFFLINE"
                                           Margin="0,8,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource LimeBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- empty library panel -->
                    <Border Padding="26"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="LibrarySummaryText"
                                           Text="Your mod library is empty. Import a ZIP archive or browse Nexus Mods to get started."
                                           Margin="0,10,20,0"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>

                            <TextBlock x:Name="LibraryStatusText"
                                       Grid.Column="1"
                                       Text="NO MODS YET"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                        Foreground="{StaticResource PurpleBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>