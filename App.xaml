<Application x:Class="Limelight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:Limelight.Animations">

    <Application.Resources>

        <!-- colour palette for this terrible idea i had (Limelight) -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#080912"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0D0F1D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#131629"/>
        <SolidColorBrush x:Key="RaisedPanelBrush" Color="#1A1E35"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2C304D"/>

        <SolidColorBrush x:Key="PinkBrush" Color="#FF3CAC"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#35E7FF"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#885CFF"/>

        <SolidColorBrush x:Key="TextBrush" Color="#F7F5FF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9296AF"/>

        <!-- I keep Limelight's motion short and consistent so it feels responsive instead of floaty. -->
        <CubicEase x:Key="LimelightEaseOut"
                   EasingMode="EaseOut"/>

        <CubicEase x:Key="LimelightEaseInOut"
                   EasingMode="EaseInOut"/>

        <!-- Each workspace arrives with the same quiet lift and fade. -->
        <Style x:Key="PageTransitionStyle"
               TargetType="FrameworkElement">
            <Setter Property="RenderTransformOrigin"
                    Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsVisible"
                         Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0"
                                                 To="1"
                                                 Duration="{motion:MotionDuration Milliseconds=200}"
                                                 EasingFunction="{StaticResource LimelightEaseOut}"/>

                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="10"
                                                 To="0"
                                                 Duration="{motion:MotionDuration Milliseconds=220}"
                                                 EasingFunction="{StaticResource LimelightEaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cards only move by two pixels. The response is visible without making the layout feel restless. -->
        <Style x:Key="AnimatedCardStyle"
               TargetType="Border">
            <Setter Property="RenderTransformOrigin"
                    Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-2"
                                                 Duration="{motion:MotionDuration Milliseconds=120}"
                                                 EasingFunction="{StaticResource LimelightEaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0"
                                                 Duration="{motion:MotionDuration Milliseconds=150}"
                                                 EasingFunction="{StaticResource LimelightEaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar movement is deliberately horizontal so it never competes with page motion. -->
        <Style x:Key="SidebarNavigationItemStyle"
               TargetType="Border">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="3"
                                                 Duration="{motion:MotionDuration Milliseconds=100}"
                                                 EasingFunction="{StaticResource LimelightEaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="0"
                                                 Duration="{motion:MotionDuration Milliseconds=130}"
                                                 EasingFunction="{StaticResource LimelightEaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modal cards appear from the centre so warnings still feel firm and intentional. -->
        <Style x:Key="AnimatedDialogCardStyle"
               TargetType="Border">
            <Setter Property="RenderTransformOrigin"
                    Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsVisible"
                         Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0"
                                                 To="1"
                                                 Duration="{motion:MotionDuration Milliseconds=160}"
                                                 EasingFunction="{StaticResource LimelightEaseOut}"/>

                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.96"
                                                 To="1"
                                                 Duration="{motion:MotionDuration Milliseconds=180}"
                                                 EasingFunction="{StaticResource LimelightEaseOut}"/>

                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.96"
                                                 To="1"
                                                 Duration="{motion:MotionDuration Milliseconds=180}"
                                                 EasingFunction="{StaticResource LimelightEaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nexus pages share one slim scrollbar so catalogue, details and files feel like one place. I love branding ! -->
        <Style x:Key="NexusScrollThumbStyle"
               TargetType="Thumb">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="#343A59"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBackground"
                                Margin="2,1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBackground"
                                        Property="Background"
                                        Value="#9A2B76"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBackground"
                                        Property="Background"
                                        Value="{StaticResource PinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NexusVerticalScrollBarStyle"
               TargetType="ScrollBar">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="#111528"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="True"
                                   Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource NexusScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- navigation buttons -->
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1B1E35"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- pink action buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PinkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                RenderTransformOrigin="0.5,0.5"
                                CornerRadius="7">

                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                         Property="Opacity"
                                        Value="0.92"/>

                                <Trigger.EnterActions>
                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.025"
                                                             Duration="{motion:MotionDuration Milliseconds=110}"
                                                             EasingFunction="{StaticResource LimelightEaseOut}"/>

                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.025"
                                                             Duration="{motion:MotionDuration Milliseconds=110}"
                                                             EasingFunction="{StaticResource LimelightEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1"
                                                             Duration="{motion:MotionDuration Milliseconds=130}"
                                                             EasingFunction="{StaticResource LimelightEaseOut}"/>

                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1"
                                                             Duration="{motion:MotionDuration Milliseconds=130}"
                                                             EasingFunction="{StaticResource LimelightEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- darker secondary buttons -->
        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Background" Value="#252943"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

    </Application.Resources>
</Application>
